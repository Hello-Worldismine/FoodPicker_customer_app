{
  "expo": {
    "name": "푸드피커",
    "slug": "foodpicker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#22A06B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.foodpicker.userapp",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "주변 매장과 상품을 찾기 위해 위치 정보를 사용합니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "주변 매장 알림을 위해 위치 정보를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "리뷰 사진 첨부를 위해 사진 라이브러리 접근이 필요합니다.",
        "NSCameraUsageDescription": "리뷰 사진 촬영을 위해 카메라 접근이 필요합니다."
      }
    },
    "android": {
      "package": "com.foodpicker.userapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22A06B"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "리뷰 사진 첨부를 위해 사진 라이브러리 접근이 필요합니다.",
          "cameraPermission": "리뷰 사진 촬영을 위해 카메라 접근이 필요합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "foodpicker-userapp"
      }
    }
  }
}

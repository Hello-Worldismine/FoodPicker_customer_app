{
  "expo": {
    "name": "푸드피커",
    "slug": "foodpicker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "foodpicker",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#22A06B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.foodpicker.userapp",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "주변 매장과 상품을 찾기 위해 위치 정보를 사용합니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "주변 매장 알림을 위해 위치 정보를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "리뷰 사진 첨부를 위해 사진 라이브러리 접근이 필요합니다.",
        "NSCameraUsageDescription": "리뷰 사진 촬영을 위해 카메라 접근이 필요합니다."
      }
    },
    "android": {
      "package": "com.foodpicker.userapp",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "리뷰 사진 첨부를 위해 사진 라이브러리 접근이 필요합니다.",
          "cameraPermission": "리뷰 사진 촬영을 위해 카메라 접근이 필요합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 매장과 거리를 표시하기 위해 위치 정보가 필요합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#22A06B"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "929e1cfd-422e-4a63-879e-72dc2a88899a"
      }
    },
    "owner": "dongsik-kim"
  }
}
